#!/usr/bin/env bash
# Git post-commit hook for SmartSwitch
# Пріоритетно прошиває ESP32 бездротово по Wi-Fi (OTA) при кожному коміті

set -e
PROJECT_DIR="$(git rev-parse --show-toplevel)"
cd "$PROJECT_DIR"

echo "⚡ [SmartSwitch] Автоматична збірка бінарника..."

# Перевірка наявності secrets.h
if [ ! -f src/secrets.h ]; then
    if [ -f /home/maks/.config/smartswitch/secrets.h ]; then
        cp /home/maks/.config/smartswitch/secrets.h src/secrets.h
    fi
fi

PIO="/home/maks/.platformio/penv/bin/pio"
$PIO run -e esp32dev
BIN=".pio/build/esp32dev/firmware.bin"

# 1. Пріоритет: бездротова прошивка по Wi-Fi (без будь-яких дротів)
if curl -fsS -m 3 http://10.100.35.61/api/sys >/dev/null 2>&1; then
    echo "📶 [SmartSwitch] ESP32 знайдено в мережі (10.100.35.61). Заливаємо БЕЗДРОТОВО по Wi-Fi..."
    curl -fsS --progress-bar --max-time 90 -F "firmware=@$BIN" http://10.100.35.61/update
    echo ""
    echo "✅ [SmartSwitch] Бездротове оновлення по Wi-Fi успішне!"
    exit 0
elif curl -fsS -m 3 http://switch.local/api/sys >/dev/null 2>&1; then
    echo "📶 [SmartSwitch] ESP32 знайдено по mDNS (switch.local). Заливаємо БЕЗДРОТОВО по Wi-Fi..."
    curl -fsS --progress-bar --max-time 90 -F "firmware=@$BIN" http://switch.local/update
    echo ""
    echo "✅ [SmartSwitch] Бездротове оновлення по Wi-Fi успішне!"
    exit 0
fi

# 2. Якщо Wi-Fi недоступний, перевіряємо аварійний USB-шнур
if [ -e /dev/ttyUSB0 ]; then
    echo "🔌 [SmartSwitch] Wi-Fi недоступний, заливаємо через резервний дріт USB (/dev/ttyUSB0)..."
    $PIO run -e esp32dev -t upload --upload-port /dev/ttyUSB0
    echo "✅ [SmartSwitch] Прошито через USB!"
    exit 0
fi

echo "⚠️ [SmartSwitch] ESP32 не знайдено ні по Wi-Fi, ні по USB. Перевір живлення плати."
exit 0
